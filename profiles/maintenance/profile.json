{
  "type": "maintenance",
  "label": "Maintenance (bug-fix)",
  "mode": "defect",
  "truth_order": [
    "Explicit developer instruction",
    "Written spec / ticket acceptance criteria",
    "The reporter's expected behavior — after its premise is verified",
    "Last released behavior (and the reference system, if one is registered)",
    "Existing conventions"
  ],
  "required_roles": [],
  "recommended_roles": [
    "frontend",
    "backend",
    "database",
    "docs",
    "tests"
  ],
  "skip_roles": [],
  "modules": {
    "tracker": true,
    "db_query": true,
    "usage_metrics": true,
    "log_triage": true,
    "parity": false,
    "pr_metrics": false
  },
  "primary_commands": [
    "/analyze",
    "/fix",
    "/review-pr",
    "/db-query",
    "/log-triage",
    "/stakeholder-reply",
    "/export",
    "/area-loop"
  ],
  "always_read_mistakes": [
    "static-read-of-runtime-bug",
    "wrong-environment-evidence",
    "invalid-negative-trial"
  ],
  "scaffold": [
    "_shared/scaffold/context/environment.md",
    "_shared/scaffold/context/test-records.md",
    "_shared/scaffold/context/domain-glossary.md",
    "_shared/scaffold/context/spec-changes.json"
  ],
  "allow_create_repos": false
}
