{
  "type": "port",
  "label": "Port migration",
  "mode": "port",
  "truth_order": [
    "Explicit developer instruction",
    "Reference behavior — parity is the spec (unless context/spec-changes.json records a requested change)",
    "context/port-conventions.md (how reference concepts map to the new stack)",
    "Target stack idiom — re-derive, never transliterate"
  ],
  "required_roles": [
    [
      "legacy-frontend",
      "legacy-backend"
    ]
  ],
  "recommended_roles": [
    "frontend",
    "backend",
    "database",
    "legacy-database",
    "docs"
  ],
  "skip_roles": [],
  "modules": {
    "tracker": true,
    "db_query": true,
    "usage_metrics": true,
    "log_triage": false,
    "parity": false,
    "pr_metrics": true,
    "port_status": true
  },
  "primary_commands": [
    "/port-feature",
    "/analyze",
    "/fix",
    "/review-pr"
  ],
  "always_read_mistakes": [
    "dropped-reference-rule",
    "name-keyed-sweep"
  ],
  "scaffold": [
    "port/scaffold/context/port-map.csv",
    "port/scaffold/context/port-conventions.md",
    "_shared/scaffold/context/environment.md",
    "_shared/scaffold/context/domain-glossary.md",
    "_shared/scaffold/context/spec-changes.json"
  ],
  "allow_create_repos": true
}
